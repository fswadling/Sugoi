<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>fsharp_game</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The cast (spec 032), listed FIRST: the engine and the game name one roster, and neither
         owns it. It consumes nothing and is asset-free, so it sits below the engine — which is
         what keeps "the engine cannot reference the game" a compile error rather than a
         convention. -->
    <Compile Include="cast/Roster.fs" />

    <!-- The narrative engine (spec 025). A source folder in this project, listed before the
         game's own files: F# compiles in list order, so putting it after the cast and before the
         game makes "the engine cannot reference the game" a compile error rather than a
         convention. It also means the engine is compiled into one assembly with no package
         references of its own, which is what FR-025 asks for: usable with no graphical
         interface. -->
    <Compile Include="narrative/Vocabulary.fs" />
    <Compile Include="narrative/ParticipantIndex.fs" />
    <Compile Include="narrative/Canonical.fs" />
    <Compile Include="narrative/History.fs" />
    <Compile Include="narrative/Facts.fs" />
    <Compile Include="narrative/Rules.fs" />
    <Compile Include="narrative/Derive.fs" />
    <Compile Include="narrative/Units/Cast.fs" />
    <Compile Include="narrative/Units/Friendship.fs" />
    <Compile Include="narrative/Units/Romance.fs" />
    <Compile Include="narrative/Engine.fs" />
    <Compile Include="narrative/Harness.fs" />

    <Compile Include="core/SlotMap.fs" />
    <Compile Include="core/Lru.fs" />
    <Compile Include="core/Iqm.fs" />
    <Compile Include="core/Gltf.fs" />
    <Compile Include="core/Input.fs" />
    <!-- Spline geometry (spec 054): a curve through points and a turn through rotations, sampled at a
         global parameter. Pure and device-free (positions/rotations only), so it sits in `core` and is
         exercised on its own; the cue's camera flight is its first caller. -->
    <Compile Include="core/Maths.fs" />
    <Compile Include="physics/Physics.fs" />
    <Compile Include="render/Gpu.fs" />
    <Compile Include="render/Texture.fs" />
    <Compile Include="render/Mesh.fs" />
    <Compile Include="render/StaticMesh.fs" />
    <Compile Include="render/InstanceBuffer.fs" />
    <Compile Include="render/ImGui.fs" />
    <Compile Include="render/ImGuiSdl3.fs" />
    <Compile Include="render/Camera.fs" />
    <Compile Include="render/DebugDraw.fs" />
    <!-- The game's own screen-space 2D layer (spec 038): one blended, depth-less
         pipeline, one quad batch, and SDL_ttf text. Technology-only — it knows Gpu,
         Texture and the font, and nothing of characters or dialogue. -->
    <Compile Include="render/Ui.fs" />
    <!-- The dialogue state and its closed vocabulary (spec 038). Only needs the cast,
         so it sits before the actor and systems modules and stays free of GPU and assets. -->
    <Compile Include="world/Dialogue.fs" />
    <Compile Include="world/Actor.fs" />
    <Compile Include="world/ActorAsset.fs" />
    <Compile Include="world/ActorRender.fs" />
    <Compile Include="world/EnvironmentAsset.fs" />
    <Compile Include="world/EnvironmentRender.fs" />
    <!-- The named adventure flags (spec 055): story milestones as a closed union, recorded in an
         immutable, ordered set — project state that belongs to no zone. Pure data — it names no zone,
         screen, asset or device — so it sits before the state that holds it. -->
    <Compile Include="world/Advent.fs" />
    <!-- The async load substrate (spec 053): the decoded payload, the bounded recency queue and the
         worker pool. CPU-only; depends on `Gltf` and `Texture`, and is depended on by `Assets`. -->
    <Compile Include="world/AssetLoad.fs" />
    <Compile Include="world/Assets.fs" />
    <Compile Include="world/Casting.fs" />
    <!-- The dialogue view (spec 038): the only module that knows the whole chain from a
         character to the asset's portraits to the atlas. Needs Assets, Casting, Ui and
         Dialogue, so it sits after them. -->
    <Compile Include="world/DialogueRender.fs" />
    <!-- The interact prompt's view (spec 039): the 2D layer's second consumer. Needs only `Ui`,
         so it sits beside the dialogue view. -->
    <Compile Include="world/PromptRender.fs" />
    <Compile Include="world/Entity.fs" />
    <Compile Include="world/EnvironmentBatch.fs" />
    <!-- The record of a registered zone (spec 034): listed before `Zone.fs`, because the loader there
         takes one as its argument. -->
    <Compile Include="world/ZoneTemplate.fs" />
    <Compile Include="world/Zone.fs" />
    <!-- The game's places and the zone registered at each (spec 034). Listed after `Zone.fs`, and it
         needs neither that module nor any editor one: it records environments, not zones. -->
    <Compile Include="world/ZoneRegistry.fs" />
    <!-- The cue — and therefore the run (spec 046): one type, the vocabulary and its execution
         state, shrinking to `Fin`. Needs `Prime` and `System.Numerics` only, and names no zone,
         screen, asset or device — so it sits before the state that must name it, and stays
         loadable on its own. -->
    <Compile Include="world/Cue.fs" />
    <Compile Include="world/Systems.fs" />
    <Compile Include="state/Screen.fs" />
    <Compile Include="state/SharedState.fs" />
    <Compile Include="state/Command.fs" />
    <Compile Include="state/EditorState.fs" />
    <Compile Include="state/GameplayState.fs" />
    <!-- The cue engine (spec 046). Listed AFTER the gameplay state — a deliberate inversion, the
         only `world/` file below `state/` — because the ops perform their effects on that state
         where the walk reaches them: a zone switch, an exposition, a camera flight (research D3).
         It must precede `screen/GameplayScreen.fs`, which ticks it. -->
    <Compile Include="world/CueEngine.fs" />
    <!-- The one undo history (spec 048). Listed AFTER the gameplay state — the same deliberate inversion
         the cue engine follows, and the project's second — because a zone step adds, removes and switches a
         zone. The `Command` type stays above the state; only the runners move here. -->
    <Compile Include="state/History.fs" />
    <Compile Include="editor/Spawning.fs" />
    <Compile Include="editor/Selection.fs" />
    <Compile Include="editor/Raycast.fs" />
    <Compile Include="editor/Viewport.fs" />
    <Compile Include="editor/Outliner.fs" />
    <Compile Include="editor/Inspector.fs" />
    <Compile Include="editor/AssetBrowser.fs" />
    <Compile Include="editor/CastPanel.fs" />
    <!-- The named adventure flags' panel (spec 055): a tab beside the Inspector on the right. It writes
         through `History.commit`, so a toggle is one `Advent` step on the one history. -->
    <Compile Include="editor/AdventPanel.fs" />
    <Compile Include="editor/ZoneRegistryPanel.fs" />
    <!-- The dialogue authoring surface (spec 038): a panel of its own, because the dialogue
         state is not a selection and so cannot live in the Inspector. -->
    <Compile Include="editor/DialoguePanel.fs" />
    <!-- The cue panel and the one control it draws through (spec 047). The control first: it holds the cue's
         row vocabulary, the read-only rule for what is executing, and the path helpers, all as pure
         functions the suite asserts headlessly, plus the thin drawing over them. The panel calls the
         control, and `editor/Editor.fs` calls the panel. Both follow `state/`: the panel writes
         `GameplayState.Cue`, and the editor's own state holds the cue's history. -->
    <Compile Include="editor/CueTree.fs" />
    <Compile Include="editor/CueEditor.fs" />
    <Compile Include="editor/Editor.fs" />
    <Compile Include="screen/MainMenuScreen.fs" />
    <Compile Include="screen/GameplayScreen.fs" />
    <Compile Include="screen/ScreenManager.fs" />
    <Compile Include="screen/DebugOverlay.fs" />
    <Compile Include="Engine.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- Native ImGui library, built by native/build.sh. Copied next to the
       apphost so `DllImport("cimgui")` resolves it at runtime. -->
  <Target Name="CopyImGuiBackend" AfterTargets="Build" Condition="Exists('native/libcimgui.so')">
    <Copy SourceFiles="native/libcimgui.so" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- Vendored SDL3_image native library (from ppy.sdl3_image-cs) plus its
       libjbig dependency. `DllImport("SDL3_image")` resolves libSDL3_image.so
       from the app dir; libjbig.so.0 is preloaded in Texture.fs before the first
       decode so the dynamic linker can satisfy SDL_image's NEEDED entry. -->
  <Target Name="CopySdl3ImageLibraries" AfterTargets="Build" Condition="Exists('native/libSDL3_image.so')">
    <Copy SourceFiles="native/libSDL3_image.so;native/libjbig.so.0" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- Vendored SDL3_ttf native library (from ppy.sdl3_ttf-cs). Unlike
       libSDL3_image.so it needs no FreeType or other transitive library, so it is
       a single file. `DllImport("SDL3_ttf")` resolves it from the app dir. -->
  <Target Name="CopySdl3TtfLibrary" AfterTargets="Build" Condition="Exists('native/libSDL3_ttf.so')">
    <Copy SourceFiles="native/libSDL3_ttf.so" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- Compiled line shader SPIR-V, loaded from disk at startup. Copied to the
       output dir so the shaders/ path resolves regardless of working dir. -->
  <Target Name="CopyShaders" AfterTargets="Build">
    <Copy SourceFiles="shaders/line.vert.spv;shaders/line.frag.spv;shaders/mesh.vert.spv;shaders/cel.frag.spv;shaders/outline.frag.spv;shaders/static.vert.spv;shaders/static.frag.spv;shaders/ui.vert.spv;shaders/ui.frag.spv" DestinationFolder="$(OutDir)shaders" />
  </Target>

  <ItemGroup>
    <PackageReference Include="JoltPhysicsSharp" Version="2.22.0" />
    <PackageReference Include="JoltPhysics.Native" Version="1.1.0" />
    <PackageReference Include="Prime" Version="11.5.2" />
    <PackageReference Include="SDL3-CS" Version="3.4.14.1" />
  </ItemGroup>

</Project>
