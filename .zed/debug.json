// Requires a netcoredbg Zed debug adapter. Zed ships no .NET adapter and none
// is in the official registry, so install a dev extension (see README/notes):
//   zed: install dev extension  ->  a netcoredbg adapter repo
// The extension downloads netcoredbg itself, or point at one you installed:
//   "dap": { "netcoredbg": { "binary": "~/.local/bin/netcoredbg" } }
[
  {
    "adapter": "netcoredbg",
    "label": "Debug game",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/bin/Debug/net10.0/Sugoi.dll",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [],
    "env": {},
    "stopAtEntry": false,
    "build": "Build project"
  },
  {
    "adapter": "netcoredbg",
    "label": "Attach to running game",
    "request": "attach"
  }
]
