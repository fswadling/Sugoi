<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestSupport.fs" />
    <Compile Include="SlotMapTests.fs" />
    <Compile Include="LruTests.fs" />
    <Compile Include="DiagnosticsTests.fs" />
    <!-- The pure half of async environment loading (spec 053): the pending set's bound/dedup/recency/
         pinning/drop and the pool's concurrent-decode bound. Device-free. -->
    <Compile Include="AssetLoadTests.fs" />
    <Compile Include="EntityTests.fs" />
    <Compile Include="AssetsTests.fs" />
    <!-- The audio-load logic (spec 086): discovery, the sound/music residency split, failure marking
         and release, asserted against a fake context (no device). -->
    <Compile Include="AudioTests.fs" />
    <!-- The music mix logic (spec 087): gain composition, add/remove, the setters and the start rule,
         plus the `SetMix` step on the one history — all device-free. -->
    <Compile Include="MusicTests.fs" />
    <!-- The one-shot sound pool (spec 089): round-robin reuse, the per-asset Stop, Stop all, release
         and the `soundAssets` readout — all device-free (against `Audio.unavailable`). -->
    <Compile Include="SoundTests.fs" />
    <!-- The music cue ops (spec 088): each op's effect on the mix/rack, the ramps' `…State` transitions,
         the no-op rules and the 0-step property — all device-free. -->
    <Compile Include="MusicCueTests.fs" />
    <!-- The actor name index (spec 074): the speaker -> asset resolution, pure and device-free. -->
    <Compile Include="AssetNameIndexTests.fs" />
    <Compile Include="InputTests.fs" />
    <Compile Include="CameraTests.fs" />
    <Compile Include="RaycastTests.fs" />
    <Compile Include="IqmTests.fs" />
    <Compile Include="GltfTests.fs" />
    <Compile Include="ActorTests.fs" />
    <Compile Include="SwayTests.fs" />
    <Compile Include="PhysicsTests.fs" />
    <Compile Include="ZoneTests.fs" />
    <Compile Include="SpawningTests.fs" />
    <Compile Include="SelectionTests.fs" />
    <Compile Include="PlayerTests.fs" />
    <Compile Include="SystemsTests.fs" />
    <Compile Include="GameplayStateTests.fs" />
    <!-- Actors addressed by name (spec 072): the resolver scans the present places, a name is a label, and the
         real spawn path runs headlessly against a fabricated actor asset. -->
    <Compile Include="ActorNameTests.fs" />
    <Compile Include="EnvironmentBatchTests.fs" />

    <!-- The cel actor shading (spec 040): the pure face-mesh rule and the face-light direction. -->
    <Compile Include="CelTests.fs" />

    <!-- The dialogue layer (spec 038): the panel layout and the dismiss rule, both pure. -->
    <Compile Include="DialogueTests.fs" />

    <!-- The interact prompt (spec 039): the pure layout. -->
    <Compile Include="PromptTests.fs" />

    <!-- The screen fade (spec 059): the default level and the pure overlay rule (the no-op at 0 and the
         full-view coverage), asserted with no device. -->
    <Compile Include="FadeTests.fs" />

    <!-- The reference grid's visibility (spec 093): the editor-only gate on the viewport's grid
         accumulator — built while editing, emptied while playing — asserted with no device. -->
    <Compile Include="ViewportTests.fs" />

    <!-- A zone's authored light (spec 043): the pitch/yaw -> direction derivation and the defaults
         that keep an unedited scene identical to the constant they replace. -->
    <Compile Include="LightTests.fs" />

    <!-- A zone's authored sky (spec 092): the value's defaults and the `SetSkydome` editor step on
         the one history — all headless. The staging round-trip is asserted in `ScenarioForkTests`. -->
    <Compile Include="SkydomeTests.fs" />

    <!-- The roster (spec 074 moved it into the narrative subsystem): the closed union and its enumeration. -->
    <Compile Include="RosterTests.fs" />



    <!-- Narrative engine tests (spec 025). NarrativeTestSupport is first: the other
         files open it for the MVP rule set, and it needs no graphics native, so these
         run headlessly with the rest of the suite. -->
    <Compile Include="NarrativeTestSupport.fs" />
    <Compile Include="NarrativeVocabularyTests.fs" />
    <Compile Include="NarrativeCommitTests.fs" />
    <Compile Include="NarrativeProjectionTests.fs" />
    <Compile Include="NarrativeDerivationTests.fs" />
    <Compile Include="NarrativeRuleSetTests.fs" />
    <Compile Include="NarrativeHarnessTests.fs" />
    <Compile Include="NarrativePerformanceTests.fs" />

    <!-- The cue engine (spec 046): the four stories, the edge cases, the two allocation
         properties and the two bounded-shape properties, all asserted headlessly. -->
    <Compile Include="CueTests.fs" />

    <!-- The cue panel (spec 047): the control's pure half — the rows, the read-only rule, the path helpers
         and the cue's own history — asserted headlessly, so what the panel shows and what it will let the
         author change are checkable with no device. -->
    <Compile Include="CuePanelTests.fs" />

    <!-- The adventure flags (spec 055): the milestone union and its `Set`, the panel's write path, and
         the flag edit on the one history — all headless. -->
    <Compile Include="AdventTests.fs" />

    <!-- The scenario library (spec 070): the capture (pure, device-free) and the registration step on
         the one history, both headless. -->
    <Compile Include="ScenarioTests.fs" />

    <!-- The scenario fork (spec 078): the materialiser, the cue op, the editor step and its undo/redo, the
         footprint rules, non-idempotence, the capacity no-op and the unregistered no-op — all headless. -->
    <Compile Include="ScenarioForkTests.fs" />
  </ItemGroup>

  <!-- Serialize test collections: `Physics.create` calls Jolt's process-global
       `Foundation.Init`, so parallel worlds are unsafe. -->
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck" Version="3.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../fsharp-game.fsproj" />
  </ItemGroup>

</Project>
